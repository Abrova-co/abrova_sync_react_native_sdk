{
  "name": "@abrova/sync-react-native",
  "version": "0.3.0",
  "description": "React Native SDK for AbrovaSync realtime database - Firebase alternative",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "THIRD_PARTY_NOTICES.md",
    "!lib/typescript/example",
    "!src/__tests__",
    "!lib/**/__tests__",
    "!android/build",
    "!ios/build"
  ],
  "scripts": {
    "test": "jest --forceExit",
    "typescript": "tsc --noEmit",
    "version-sync": "node scripts/sync-version.js",
    "version-check": "node scripts/sync-version.js --check",
    "version": "node scripts/sync-version.js && git add src/version.ts",
    "prepublishOnly": "node scripts/sync-version.js --check",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "realtime",
    "database",
    "firebase",
    "abrova_sync",
    "abrovasync"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Abrova-co/abrova_sync_react_native_sdk.git"
  },
  "author": "Abrova <support@abrova.ir>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Abrova-co/abrova_sync_react_native_sdk/issues"
  },
  "homepage": "https://abrova.ir/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.0",
    "@types/react-native": "^0.72.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-native-builder-bob": "^0.23.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json"
    ]
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
